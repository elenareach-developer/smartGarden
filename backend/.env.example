# Скопируйте в backend/.env. Файл .env не попадает в git.

# Ключ Claude API хранится ТОЛЬКО на сервере. Без ключа работает Demo AI Mode.
ANTHROPIC_API_KEY=
# auto — Claude при наличии ключа, иначе Demo; demo — всегда Demo; claude — Claude (fallback на Demo при ошибке)
AI_MODE=auto
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# SQLite по умолчанию. Для PostgreSQL: postgresql+psycopg://user:password@localhost:5432/smart_orchid
# DATABASE_URL=sqlite:///./smart_orchid.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
